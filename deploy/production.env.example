DJANGO_SETTINGS_MODULE=laneslane.production
DJANGO_SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=art.example.com
DJANGO_DATA_DIR=/var/lib/laneslane
DJANGO_STATIC_ROOT=/srv/laneslane/staticfiles
# Optional: configure these if you need outgoing email/password resets.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=your-account
# SMTP_PASSWORD=your-password
# DEFAULT_FROM_EMAIL=artist@example.com
